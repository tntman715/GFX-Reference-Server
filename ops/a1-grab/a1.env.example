# Copy to /home/ubuntu/a1-grab/a1.env. These are IDs, not secrets; the private key stays in ~/.oci.
OCI_USER=ocid1.user.oc1..xxxx
OCI_TENANCY=ocid1.tenancy.oc1..xxxx
OCI_FINGERPRINT=aa:bb:...
OCI_REGION=ap-osaka-1
OCI_KEY_FILE=~/.oci/oci_api_key.pem

# What to ask for (Always Free allows up to 4 OCPU / 24 GB in total)
A1_OCPUS=2
A1_MEMORY_GB=12
A1_BOOT_GB=50
A1_NAME=gfx-a1

{
  "manifestVersion": 5,
  "id": "gfx.references.panel",
  "name": "GFX References",
  "version": "2.0.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "23.3.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "gfxReferencesPanel",
      "label": { "default": "GFX References" },
      "minimumSize": { "width": 260, "height": 320 },
      "maximumSize": { "width": 2000, "height": 4000 },
      "preferredDockedSize": { "width": 320, "height": 680 },
      "preferredFloatingSize": { "width": 380, "height": 760 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/panel.png", "scale": [1, 2], "theme": ["all"], "species": ["chrome"] }
      ]
    }
  ],
  "requiredPermissions": {
    "network": { "domains": "all" },
    "localFileSystem": "plugin",
    "launchProcess": { "schemes": ["https", "http"], "extensions": [] }
  },
  "icons": [
    { "width": 48, "height": 48, "path": "icons/plugin.png", "scale": [1, 2], "theme": ["all"], "species": ["pluginList"] }
  ]
}

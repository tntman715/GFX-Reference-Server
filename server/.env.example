# ─────────────────────────────────────────────────────────────
#  GFX References 서버 설정
#  이 파일을 .env 로 복사한 뒤 값을 채워주세요.  (cp .env.example .env)
# ─────────────────────────────────────────────────────────────

# 사이트/API 가 외부에서 접속되는 주소 (끝에 / 없이)
# 디스코드 OAuth 리다이렉트, 임베드 링크, 미리보기 주소에 사용됩니다.
PUBLIC_BASE_URL=https://gfx.example.com
PORT=3000

# ── 디스코드 ─────────────────────────────────────────────────
# https://discord.com/developers/applications 에서 앱을 만든 뒤
#   Bot 탭 → Reset Token 으로 받은 토큰
DISCORD_TOKEN=
#   General Information 탭의 Application ID / Client Secret (OAuth2 탭)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# GFX References 서버(길드) ID — 개발자 모드 켜고 서버 아이콘 우클릭 → ID 복사
DISCORD_GUILD_ID=

# 원본 사진을 보관할 채널 (봇만 글을 쓰는 채널을 추천)
ARCHIVE_CHANNEL_ID=
# 분류마다 다른 채널에 보관하고 싶다면 (비우면 ARCHIVE_CHANNEL_ID 사용)
ARCHIVE_CHANNEL_GM_THUMBNAIL=
ARCHIVE_CHANNEL_GM_ARTWORK=
ARCHIVE_CHANNEL_NON_GM=

# 매주 월요일 "이번 주 인기 레퍼런스 TOP 5" 를 올릴 채널 (비우면 자동 게시 안 함)
HIGHLIGHT_CHANNEL_ID=
# /업로드 를 특정 채널에서만 쓰게 하려면 채널 ID 를 쉼표로 (비우면 모든 채널)
UPLOAD_CHANNEL_IDS=
# 관리자 역할 ID (쉼표로 여러 개). "서버 관리" 권한이 있는 사람은 자동으로 관리자입니다.
ADMIN_ROLE_IDS=
# 웹 로그인 시 GFX References 서버 멤버만 허용
REQUIRE_GUILD_MEMBERSHIP=true

# ── 데이터베이스 (태그 · 이름 · 제작자 · 반응 · 점수) ─────────
# Neon / Supabase 등 무료 Postgres 주소. 비우면 data/pglite 에 내장 DB 를 사용합니다.
# 예) postgres://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
DATABASE_SSL=true

# ── 미리보기 이미지 저장소 ───────────────────────────────────
# local: 서버 디스크(data/previews)  /  s3: Cloudflare R2 등 S3 호환 저장소 (R2 무료 10GB)
STORAGE_DRIVER=local
# Cloudflare R2 예시
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_REGION=auto
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=
# 버킷의 공개 주소 (R2 → 버킷 → Settings → Public access 의 r2.dev 주소 또는 커스텀 도메인)
# 설정하면 사이트/디스코드가 R2 에서 바로 미리보기를 불러옵니다. 비우면 서버가 중계합니다.
PREVIEW_PUBLIC_BASE_URL=

# ── 업로드 / 이미지 ─────────────────────────────────────────
# 봇이 원본을 아카이브 채널에 다시 올리므로 서버의 첨부 한도 이하로 설정하세요.
# (부스트 없음 10MB · 2레벨 50MB · 3레벨 100MB)
MAX_UPLOAD_MB=10
# 미리보기 최대 크기(px)와 WebP 품질 — 720px / 72 이면 장당 보통 40~120KB
PREVIEW_MAX_SIZE=720
PREVIEW_QUALITY=72
# 비슷한 이미지 중복 경고 민감도 (0 이면 끔, 클수록 더 많이 잡음)
DUPLICATE_THRESHOLD=5

# ── 점수 / 반응 ─────────────────────────────────────────────
POINTS_PER_UPLOAD=10
POINTS_PER_REACTION=1
# 반응으로 쓸 이모지 (최대 5개, 첫 번째가 대표 반응)
REACTION_EMOJIS=⭐,🔥,💎
WEEKLY_HIGHLIGHT=true
TIMEZONE=Asia/Seoul

# ── 기타 ────────────────────────────────────────────────────
# 웹사이트를 다른 도메인(예: Cloudflare Pages)에서 호스팅할 때만 설정
CORS_ORIGINS=
# 로그인 유지 기간 (일)
SESSION_DAYS=30
PLUGIN_TOKEN_DAYS=180
# 디스코드 없이 테스트할 때: BOT_ENABLED=false (원본은 data/originals 에 보관)
BOT_ENABLED=true
LOG_LEVEL=info

{
  "manifest_version": 3,
  "name": "GFX References 보관함",
  "short_name": "GFX 보관함",
  "version": "0.2.0",
  "description": "핀터레스트 등에서 마음에 드는 사진을 보관함에 담아 두었다가 GFX References 에 올립니다.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "GFX 보관함 열기",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["contextMenus", "storage", "unlimitedStorage"],
  "host_permissions": ["https://i.pinimg.com/*", "https://gfxref.duckdns.org/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": [
        "https://*.pinterest.com/*",
        "https://*.pinterest.co.kr/*",
        "https://*.pinterest.co.uk/*",
        "https://*.pinterest.jp/*",
        "https://*.pinterest.de/*",
        "https://*.pinterest.fr/*",
        "https://*.pinterest.ca/*",
        "https://*.pinterest.com.au/*"
      ],
      "js": ["content/pinterest.js"],
      "run_at": "document_idle"
    }
  ]
}
